# Copy to `.env.local` and fill in. Never commit `.env` or any real key.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Anything
# sensitive must stay server-side. The anon key below is safe to ship: Supabase
# row-level security is what protects the data, not the key being secret.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key. Row-level security must be enabled on every table.
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed site, e.g. https://habittra.app
# Used for auth redirect URLs and absolute links.
VITE_APP_URL=http://localhost:5173

# Copy to `.env.local` and fill in. Never commit `.env` or any real key.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Anything
# sensitive must stay server-side. The anon key below is safe to ship: Supabase
# row-level security is what protects the data, not the key being secret.
#
# SETUP_SUPABASE.md has the step by step version, including where in the Supabase
# dashboard each of these values comes from.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard -> Project Settings -> Data API -> Project URL.
VITE_SUPABASE_URL=

# Supabase anon / publishable key.
# Dashboard -> Project Settings -> API Keys -> Publishable key / anon public key.
# Row-level security must be enabled on every table. Do not use the service_role
# key here: it bypasses RLS and must never reach a browser.
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed site, e.g. https://habittra.app
# Used to build auth redirect URLs and absolute links. Optional: when it is unset
# the app uses the origin it is served from, which is right for local dev.
# Every value of this must also be listed under Authentication -> URL
# Configuration in the Supabase dashboard.
VITE_APP_URL=http://localhost:5173

# Shows the "Continue with Google" button on /login and /signup.
# Set to `true` only after a Google OAuth client exists and the redirect URLs are
# in place. Anything else, including leaving it out, hides the button, so email
# and password works on a project with no Google set up.
VITE_ENABLE_GOOGLE_AUTH=false